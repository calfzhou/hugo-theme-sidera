{{- .EnableAllLanguages -}}
{{- $nodes := newScratch -}}
{{- range slice "routes" "native" "identities" "native_collisions" "authored" -}}{{- $nodes.Set . dict -}}{{- end -}}
{{- $tree := partial "tags/source-tree.html" (dict "dir" "." "context" (dict "fs" .Site.BaseFs.Content.Fs "source" .Site.SourceSpec)) -}}
{{- partial "tags/discover.html" (dict "owner" "" "nodes" $nodes "tree" $tree) -}}
{{- /* Declared author profiles register identities even when assignments arrive via
     native cascade. Inventory routes only; native published Pages decide membership. */ -}}
{{- range $path, $_ := $nodes.Get "authored" -}}
  {{- if and (hasPrefix $path "authors/") (ne $path "authors/_index.md") (hasSuffix $path "/_index.md") -}}
    {{- $raw := strings.TrimSuffix "/_index.md" (strings.TrimPrefix "authors/" $path) -}}
    {{- $key := printf "authors/%s" $raw -}}
    {{- if not (isset ($nodes.Get "native") $key) -}}
      {{- $nodes.SetInMap "native" $key (dict "taxonomy" "authors" "raw" $raw "key" $raw) -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- range $route, $node := $nodes.Get "routes" -}}
  {{- if and (eq $node.taxonomy "authors") (not $node.key) -}}
    {{- range $nodes.Get "native" -}}
      {{- if eq .taxonomy "authors" -}}
        {{- range partial "tags/normalize.html" (dict "tags" (slice .raw) "source" $route) -}}
          {{- $nodes.SetInMap "routes" (printf "%s/%s" $route .slug) (dict "key" .key "slug" .slug "taxonomy" "authors") -}}
        {{- end -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- range $path, $conflict := $nodes.Get "native_collisions" -}}{{- errorf "Sidera native taxonomy path collision at %s: %s" $path $conflict -}}{{- end -}}
{{- range $route, $node := $nodes.Get "routes" -}}
  {{- if $node.archive -}}
    {{- $.AddPage (dict "kind" "section" "path" $route "title" (T "archives") "layout" "archive" "build" (dict "list" "never" "render" "always") "params" (dict "sidera" (dict "archive_view" true))) -}}
  {{- else -}}
  {{- $title := T $node.taxonomy -}}{{- with $node.key -}}{{- $title = . -}}{{- end -}}
  {{- $.AddPage (dict "kind" "section" "path" $route "title" $title "layout" "taxonomy-scope"
    "params" (dict "sidera" (dict "tag_view" true "tag_key" $node.key "tag_slug" $node.slug "tag_taxonomy" $node.taxonomy))) -}}
  {{- end -}}
{{- end -}}
{{- range $path, $term := $nodes.Get "native" -}}
  {{- /* Native authored term pages take precedence; don't shadow source content. */ -}}
  {{- $nativePath := lower (replaceRE `\s` "-" $path) -}}
  {{- if not (index ($nodes.Get "authored") (printf "%s/_index.md" $nativePath)) -}}
    {{- $page := dict "kind" "term" "path" (printf "%s/%s" $term.taxonomy $term.raw) "title" $term.raw "slug" (strings.TrimPrefix (printf "%s/" $term.taxonomy) $path) "params" (dict "sidera" (dict "inferred_term" true "term_key" (index (partial "tags/normalize.html" (dict "tags" (slice $term.raw) "source" $path)) 0).key)) -}}
    {{- if findRE `[^\x00-\x7F]` $term.raw -}}
      {{- $slugs := slice -}}{{- range split $term.raw "/" -}}{{- $slugs = $slugs | append (printf "u-%x" .) -}}{{- end -}}
      {{- $page = merge $page (dict "slug" (delimit $slugs "/")) -}}
    {{- end -}}
    {{- $.AddPage $page -}}
  {{- end -}}
{{- end -}}
